///|
fn mbt_fn_ident(op_id : String) -> String {
  let sb = StringBuilder()
  for ch in op_id {
    let c = ch.to_int()
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || ch == '_' {
      sb.write_char(ch)
    } else if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_char('_')
    }
  }
  let res = sb.to_string()
  if res.is_empty() {
    "call"
  } else {
    res
  }
}

///|
pub fn generate_eden_mbt(openapi_json : Json) -> String raise GenError {
  guard openapi_json is Object(root) else {
    raise GenError::InvalidOpenApi("OpenAPI root must be a JSON object")
  }
  let sb = StringBuilder()
  sb.write_string("// Generated by unmbt/ciallo-gen eden; DO NOT EDIT.\n\n")
  sb.write_string(
    "///|\npub struct EdenClient {\n  base_url : String\n  transport : &@runtime.HttpClient\n}\n\n",
  )
  sb.write_string(
    "///|\npub fn EdenClient::EdenClient(base_url~ : String, transport~ : &@runtime.HttpClient) -> EdenClient {\n  { base_url, transport }\n}\n",
  )
  match root.get("paths") {
    Some(Object(paths)) =>
      paths.each((oa_path, path_val) => {
        match path_val {
          Object(methods) =>
            methods.each((meth_lower, op_val) => {
              match op_val {
                Object(op) => {
                  let op_id = match op.get("operationId") {
                    Some(String(id)) => id
                    _ => "\{meth_lower}_\{oa_path}"
                  }
                  let fn_name = mbt_fn_ident(op_id)
                  let meth_upper = meth_lower.to_upper()
                  let path_params : Array[String] = []
                  match op.get("parameters") {
                    Some(Array(plist)) =>
                      for p in plist {
                        match p {
                          Object(pm) =>
                            if pm.get("in") == Some(Json::string("path")) {
                              match pm.get("name") {
                                Some(String(pn)) => path_params.push(pn)
                                _ => ()
                              }
                            }
                          _ => ()
                        }
                      }
                    _ => ()
                  }
                  let has_body = op.contains("requestBody")
                  let sig_params : Array[String] = ["self : EdenClient"]
                  for pp in path_params {
                    sig_params.push("\{mbt_fn_ident(pp)}~ : String")
                  }
                  if has_body {
                    sig_params.push("body~ : Json")
                  }
                  let sig_joined = sig_params.join(", ")
                  sb.write_string("\n///|\n")
                  sb.write_string(
                    "pub async fn EdenClient::\{fn_name}(\{sig_joined}) -> @http.Response raise {\n",
                  )
                  sb.write_string(
                    "  let mut path = \"\{escape_mbt_string(oa_path)}\"\n",
                  )
                  for pp in path_params {
                    let p_ident = mbt_fn_ident(pp)
                    sb.write_string(
                      "  path = path.replace(old=\"{\{pp}}\", new=\{p_ident})\n",
                    )
                  }
                  sb.write_string("  let headers = @http.Headers::Headers()\n")
                  if has_body {
                    sb.write_string(
                      "  headers.set(\"content-type\", \"application/json\")\n",
                    )
                    sb.write_string(
                      "  let req = @http.Request::Request(meth=@http.Method::parse(\"\{meth_upper}\"), url=\"\\{self.base_url}\\{path}\", headers~, body=@http.Body::Text(body.stringify()))\n",
                    )
                  } else {
                    sb.write_string(
                      "  let req = @http.Request::Request(meth=@http.Method::parse(\"\{meth_upper}\"), url=\"\\{self.base_url}\\{path}\", headers~)\n",
                    )
                  }
                  sb.write_string("  self.transport.send(req)\n}\n")
                }
                _ => ()
              }
            })
          _ => ()
        }
      })
    _ => ()
  }
  sb.to_string()
}
