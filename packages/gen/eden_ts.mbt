///|
fn ts_ident(raw : String) -> String {
  let sb = StringBuilder()
  let mut capitalize_next = true
  for ch in raw {
    let c = ch.to_int()
    let is_alnum = (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      (c >= 48 && c <= 57)
    if is_alnum {
      if capitalize_next && c >= 97 && c <= 122 {
        sb.write_char((c - 32).unsafe_to_char())
      } else {
        sb.write_char(ch)
      }
      capitalize_next = false
    } else {
      capitalize_next = true
    }
  }
  let res = sb.to_string()
  if res.is_empty() {
    "Unnamed"
  } else {
    res
  }
}

///|
fn ts_method_name(op_id : String) -> String {
  let sb = StringBuilder()
  let mut cap = false
  for ch in op_id {
    if ch == '_' || ch == '-' || ch == '.' || ch == '/' {
      cap = true
    } else if cap {
      let c = ch.to_int()
      if c >= 97 && c <= 122 {
        sb.write_char((c - 32).unsafe_to_char())
      } else {
        sb.write_char(ch)
      }
      cap = false
    } else {
      sb.write_char(ch)
    }
  }
  let out = sb.to_string()
  if out.is_empty() {
    "call"
  } else {
    out
  }
}

///|
fn oa_schema_to_ts(schema : Json) -> String {
  match schema {
    Object(map) => {
      match map.get("$ref") {
        Some(String(r)) =>
          if r.has_prefix("#/components/schemas/") {
            return ts_ident(r[21:].to_owned())
          } else {
            return "unknown"
          }
        _ => ()
      }
      match map.get("anyOf") {
        Some(Array(variants)) => {
          let parts = variants.map(v => oa_schema_to_ts(v))
          let joined = parts.join(" | ")
          return "(\{joined})"
        }
        _ => ()
      }
      match map.get("enum") {
        Some(Array(vals)) => {
          let lits : Array[String] = []
          for v in vals {
            match v {
              String(s) => lits.push("\"\{escape_mbt_string(s)}\"")
              _ => ()
            }
          }
          if !lits.is_empty() {
            return lits.join(" | ")
          }
        }
        _ => ()
      }
      match map.get("type") {
        Some(String("null")) => "null"
        Some(String("boolean")) => "boolean"
        Some(String("integer")) | Some(String("number")) => "number"
        Some(String("string")) => "string"
        Some(String("array")) =>
          match map.get("items") {
            Some(items) => "Array<\{oa_schema_to_ts(items)}>"
            None => "Array<unknown>"
          }
        Some(String("object")) =>
          match map.get("properties") {
            Some(Object(props)) => {
              let req_set : Map[String, Bool] = Map([])
              match map.get("required") {
                Some(Array(reqs)) =>
                  for r in reqs {
                    match r {
                      String(rk) => req_set[rk] = true
                      _ => ()
                    }
                  }
                _ => ()
              }
              let lines : Array[String] = []
              props.each((k, v) => {
                let opt = if req_set.contains(k) { "" } else { "?" }
                let vty = oa_schema_to_ts(v)
                lines.push("  \"\{escape_mbt_string(k)}\"\{opt}: \{vty};")
              })
              if lines.is_empty() {
                "Record<string, never>"
              } else {
                let body = lines.join("\n")
                "{\n\{body}\n}"
              }
            }
            _ =>
              match map.get("additionalProperties") {
                Some(Object(ap)) =>
                  "Record<string, \{oa_schema_to_ts(Json::object(ap))}>"
                _ => "Record<string, unknown>"
              }
          }
        _ => "unknown"
      }
    }
    _ => "unknown"
  }
}

///|
pub fn generate_eden_ts(openapi_json : Json) -> String raise GenError {
  guard openapi_json is Object(root) else {
    raise GenError::InvalidOpenApi("OpenAPI root must be a JSON object")
  }
  let sb = StringBuilder()
  sb.write_string("// Generated by unmbt/ciallo-gen eden; DO NOT EDIT.\n")
  sb.write_string("/* eslint-disable */\n\n")
  sb.write_string(
    "export interface ProblemDetails {\n  type: string;\n  title: string;\n  status: number;\n  detail: string;\n  instance?: string;\n  code: string;\n  trace_id?: string;\n  errors?: Array<{ path: string; message: string; expected: string }>;\n  source_loc?: string;\n  [key: string]: unknown;\n}\n\n",
  )
  sb.write_string(
    "export class CialloHttpError extends Error {\n  readonly status: number;\n  readonly problem: ProblemDetails | null;\n  constructor(status: number, problem: ProblemDetails | null, fallback: string) {\n    super(problem?.detail ?? fallback);\n    this.name = \"CialloHttpError\";\n    this.status = status;\n    this.problem = problem;\n  }\n}\n\n",
  )

  // Emit components.schemas
  match root.get("components") {
    Some(Object(comps)) =>
      match comps.get("schemas") {
        Some(Object(schemas)) =>
          schemas.each((name, s_json) => {
            let tname = ts_ident(name)
            let ts_ty = oa_schema_to_ts(s_json)
            sb.write_string("export type \{tname} = \{ts_ty};\n\n")
          })
        _ => ()
      }
    _ => ()
  }

  // Helpers for SSE & NDJSON
  sb.write_string(
    "async function* parseSseStream<T>(resp: Response): AsyncGenerator<T> {\n  if (!resp.body) return;\n  const reader = resp.body.getReader();\n  const decoder = new TextDecoder();\n  let buf = \"\";\n  while (true) {\n    const { done, value } = await reader.read();\n    if (done) break;\n    buf += decoder.decode(value, { stream: true });\n    let idx = buf.indexOf(\"\\n\\n\");\n    while (idx !== -1) {\n      const raw = buf.slice(0, idx);\n      buf = buf.slice(idx + 2);\n      const dataLines: string[] = [];\n      for (const line of raw.split(/\\r?\\n/)) {\n        if (line.startsWith(\"data:\")) {\n          dataLines.push(line.slice(5).trimStart());\n        }\n      }\n      if (dataLines.length > 0) {\n        yield JSON.parse(dataLines.join(\"\\n\")) as T;\n      }\n      idx = buf.indexOf(\"\\n\\n\");\n    }\n  }\n}\n\n",
  )
  sb.write_string(
    "async function* parseNdjsonStream<T>(resp: Response): AsyncGenerator<T> {\n  if (!resp.body) return;\n  const reader = resp.body.getReader();\n  const decoder = new TextDecoder();\n  let buf = \"\";\n  while (true) {\n    const { done, value } = await reader.read();\n    if (done) break;\n    buf += decoder.decode(value, { stream: true });\n    const lines = buf.split(/\\r?\\n/);\n    buf = lines.pop() ?? \"\";\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.length > 0) {\n        yield JSON.parse(trimmed) as T;\n      }\n    }\n  }\n  if (buf.trim().length > 0) {\n    yield JSON.parse(buf.trim()) as T;\n  }\n}\n\n",
  )
  sb.write_string(
    "export interface ClientOptions {\n  baseUrl: string;\n  headers?: Record<string, string>;\n  fetch?: typeof globalThis.fetch;\n}\n\n",
  )
  sb.write_string(
    "export function createClient(options: ClientOptions) {\n  const fetchImpl = options.fetch ?? globalThis.fetch;\n  const base = options.baseUrl.replace(/\\/+$/, \"\");\n  async function requestRaw(method: string, path: string, query?: Record<string, unknown>, body?: unknown): Promise<Response> {\n    let url = base + path;\n    if (query) {\n      const usp = new URLSearchParams();\n      for (const [k, v] of Object.entries(query)) {\n        if (v === undefined) continue;\n        if (Array.isArray(v)) {\n          for (const item of v) usp.append(k, String(item));\n        } else {\n          usp.set(k, String(v));\n        }\n      }\n      const qs = usp.toString();\n      if (qs.length > 0) url += \"?\" + qs;\n    }\n    const headers: Record<string, string> = { ...(options.headers ?? {}) };\n    let payload: string | undefined = undefined;\n    if (body !== undefined) {\n      headers[\"content-type\"] = \"application/json\";\n      payload = JSON.stringify(body);\n    }\n    const resp = await fetchImpl(url, { method, headers, body: payload });\n    if (!resp.ok) {\n      let problem: ProblemDetails | null = null;\n      try { problem = (await resp.json()) as ProblemDetails; } catch {}\n      throw new CialloHttpError(resp.status, problem, `HTTP ${resp.status}`);\n    }\n    return resp;\n  }\n  return {\n",
  )

  // Emit one method per operation
  match root.get("paths") {
    Some(Object(paths)) =>
      paths.each((oa_path, path_val) => {
        match path_val {
          Object(methods) =>
            methods.each((meth_lower, op_val) => {
              match op_val {
                Object(op) => {
                  let op_id = match op.get("operationId") {
                    Some(String(id)) => id
                    _ => "\{meth_lower}_\{oa_path}"
                  }
                  let mname = ts_method_name(op_id)
                  let meth_upper = meth_lower.to_upper()

                  // Path & query params
                  let path_params : Array[(String, String)] = []
                  let query_params : Array[(String, String, Bool)] = []
                  match op.get("parameters") {
                    Some(Array(plist)) =>
                      for p in plist {
                        match p {
                          Object(pm) => {
                            let pname = match pm.get("name") {
                              Some(String(s)) => s
                              _ => ""
                            }
                            let pin = match pm.get("in") {
                              Some(String(s)) => s
                              _ => ""
                            }
                            let req = match pm.get("required") {
                              Some(True) => true
                              _ => false
                            }
                            let pty = match pm.get("schema") {
                              Some(ps) => oa_schema_to_ts(ps)
                              None => "string"
                            }
                            if pin == "path" && !pname.is_empty() {
                              path_params.push((pname, pty))
                            } else if pin == "query" && !pname.is_empty() {
                              query_params.push((pname, pty, req))
                            }
                          }
                          _ => ()
                        }
                      }
                    _ => ()
                  }

                  // Body schema
                  let body_ts : String? = match op.get("requestBody") {
                    Some(Object(rb)) =>
                      match rb.get("content") {
                        Some(Object(ct)) =>
                          match ct.get("application/json") {
                            Some(Object(aj)) =>
                              match aj.get("schema") {
                                Some(bs) => Some(oa_schema_to_ts(bs))
                                None => None
                              }
                            _ => None
                          }
                        _ => None
                      }
                    _ => None
                  }

                  // Determine response kind (void / json / sse / ndjson)
                  let mut is_sse = false
                  let mut is_ndjson = false
                  let mut is_void = false
                  let mut resp_ts = "unknown"
                  match op.get("responses") {
                    Some(Object(resps)) => {
                      let mut picked : Json? = None
                      for code in ["200", "201", "202", "204"] {
                        match resps.get(code) {
                          Some(r) => {
                            picked = Some(r)
                            if code == "204" {
                              is_void = true
                            }
                            break
                          }
                          None => ()
                        }
                      }
                      match picked {
                        Some(Object(rm)) =>
                          match rm.get("content") {
                            None => is_void = true
                            Some(Object(ct)) =>
                              match ct.get("text/event-stream") {
                                Some(Object(se)) => {
                                  is_sse = true
                                  resp_ts = match se.get("schema") {
                                    Some(s) => oa_schema_to_ts(s)
                                    None => "unknown"
                                  }
                                }
                                _ =>
                                  match ct.get("application/x-ndjson") {
                                    Some(Object(nd)) => {
                                      is_ndjson = true
                                      resp_ts = match nd.get("schema") {
                                        Some(s) => oa_schema_to_ts(s)
                                        None => "unknown"
                                      }
                                    }
                                    _ =>
                                      match ct.get("application/json") {
                                        Some(Object(aj)) =>
                                          resp_ts = match aj.get("schema") {
                                            Some(s) => oa_schema_to_ts(s)
                                            None => "unknown"
                                          }
                                        _ => is_void = true
                                      }
                                  }
                              }
                            _ => is_void = true
                          }
                        _ => is_void = true
                      }
                    }
                    _ => is_void = true
                  }

                  // Build input signature
                  let arg_fields : Array[String] = []
                  if !path_params.is_empty() {
                    let pf = path_params.map(p => "\{p.0}: \{p.1}").join("; ")
                    arg_fields.push("params: { \{pf} }")
                  }
                  if !query_params.is_empty() {
                    let any_req = query_params.iter().any(q => q.2)
                    let qf = query_params
                      .map(q => {
                        let opt = if q.2 { "" } else { "?" }
                        "\{q.0}\{opt}: \{q.1}"
                      })
                      .join("; ")
                    let q_opt = if any_req { "" } else { "?" }
                    arg_fields.push("query\{q_opt}: { \{qf} }")
                  }
                  match body_ts {
                    Some(bt) => arg_fields.push("body: \{bt}")
                    None => ()
                  }
                  let sig_arg = if arg_fields.is_empty() {
                    ""
                  } else {
                    let all_opt = path_params.is_empty() &&
                      body_ts is None &&
                      !query_params.iter().any(q => q.2)
                    let opt_mark = if all_opt { "?" } else { "" }
                    let fields_joined = arg_fields.join("; ")
                    "input\{opt_mark}: { \{fields_joined} }"
                  }

                  // Build path expression with encodeURIComponent
                  let mut path_expr = "\"\{escape_mbt_string(oa_path)}\""
                  for pp in path_params {
                    let placeholder = "{\{pp.0}}"
                    path_expr = "\{path_expr}.replace(\"\{placeholder}\", encodeURIComponent(String(input.params.\{pp.0})))"
                  }
                  let q_arg = if query_params.is_empty() {
                    "undefined"
                  } else {
                    "input?.query as Record<string, unknown> | undefined"
                  }
                  let b_arg = match body_ts {
                    Some(_) => "input.body"
                    None => "undefined"
                  }

                  if is_sse {
                    sb.write_string(
                      "    async *\{mname}(\{sig_arg}): AsyncGenerator<\{resp_ts}> {\n      const resp = await requestRaw(\"\{meth_upper}\", \{path_expr}, \{q_arg}, \{b_arg});\n      yield* parseSseStream<\{resp_ts}>(resp);\n    },\n",
                    )
                  } else if is_ndjson {
                    sb.write_string(
                      "    async *\{mname}(\{sig_arg}): AsyncGenerator<\{resp_ts}> {\n      const resp = await requestRaw(\"\{meth_upper}\", \{path_expr}, \{q_arg}, \{b_arg});\n      yield* parseNdjsonStream<\{resp_ts}>(resp);\n    },\n",
                    )
                  } else if is_void {
                    sb.write_string(
                      "    async \{mname}(\{sig_arg}): Promise<void> {\n      await requestRaw(\"\{meth_upper}\", \{path_expr}, \{q_arg}, \{b_arg});\n    },\n",
                    )
                  } else {
                    sb.write_string(
                      "    async \{mname}(\{sig_arg}): Promise<\{resp_ts}> {\n      const resp = await requestRaw(\"\{meth_upper}\", \{path_expr}, \{q_arg}, \{b_arg});\n      return (await resp.json()) as \{resp_ts};\n    },\n",
                    )
                  }
                }
                _ => ()
              }
            })
          _ => ()
        }
      })
    _ => ()
  }
  sb.write_string("  };\n}\n")
  sb.to_string()
}
