import {
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/js_async",
  "unmbt/webstd/http",
  "unmbt/ciallo/core",
  "unmbt/ciallo/runtime",
}

import {
  "moonbitlang/core/async",
  "unmbt/ciallo-js" @ciallo_js,
} for "test"

supported_targets = "-all+js"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/js_async",
  ],
)
